# Supabase Postgres connection string (session pooler, port 5432).
# Use the "Session pooler" string from Project Settings > Database, not the
# "Direct connection" host (IPv6-only on new projects, hangs on many
# networks) and not the "Transaction pooler" (port 6543 - rejects the DDL
# statements schema commands need). See ARCHITECTURE.md.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?uselibpqcompat=true&sslmode=require"

# Supabase Storage (avatar upload). Project Settings > API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js secret - used to sign/encrypt JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- External media provider API keys ---
# Movies/TV. Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Books enrichment (optional - Open Library works without a key already).
# https://developers.google.com/books/docs/v1/using#APIKey
GOOGLE_BOOKS_API_KEY=

# Not wired up yet in this pass (adapters are scaffolded only): Spotify, RAWG.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
RAWG_API_KEY=
